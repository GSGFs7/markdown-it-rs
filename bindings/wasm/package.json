{
  "name": "@gsgfs/markdown-it-rs-wasm",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GSGFs7/markdown-it-rs.git",
    "directory": "bindings/wasm"
  },
  "files": [
    "pkg"
  ],
  "main": "./pkg/basic/basic.js",
  "types": "./pkg/basic/basic.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/basic/basic.d.ts",
      "import": "./pkg/basic/basic.js"
    },
    "./full": {
      "types": "./pkg/full/full.d.ts",
      "import": "./pkg/full/full.js"
    }
  },
  "sideEffects": [
    "./pkg/basic/basic.js",
    "./pkg/full/full.js"
  ],
  "scripts": {
    "clean": "rm -rf ./pkg",
    "build:basic": "wasm-pack build . --release --target bundler --out-dir pkg/basic --out-name basic --no-pack -- --locked --no-default-features",
    "build:full": "wasm-pack build . --release --target bundler --out-dir pkg/full --out-name full --no-pack -- --locked --no-default-features --features full",
    "build": "npm run clean && npm run build:basic && npm run build:full",
    "test": "npm run build && npm run test:js",
    "test:js": "node --test",
    "postbuild": "rm ./pkg/basic/.gitignore ./pkg/full/.gitignore",
    "prepack": "npm run build"
  }
}
